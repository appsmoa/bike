# 카카오맵 JavaScript 키 (https://developers.kakao.com > 내 애플리케이션 > 앱 키)
# 카카오 개발자센터의 "플랫폼 > Web > 사이트 도메인"에 배포 도메인을 등록해야 지도가 표시됩니다.
REACT_APP_KAKAO_MAP_API_KEY=

# 서울 열린데이터광장 인증키 (https://data.seoul.go.kr > 인증키 신청)
# 따릉이 대여소 목록 API(bikeList) 호출에 사용됩니다. 값을 채우지 않으면 대여소 목록이 표시되지 않습니다.
REACT_APP_SEOUL_OPEN_API_KEY=
